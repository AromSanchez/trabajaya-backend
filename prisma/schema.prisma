generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  cliente
  tecnico
  admin
}

enum EstadoVerificacion {
  pendiente
  aprobado
  observado
  rechazado
}

enum Oficio {
  gasfiteria
  electricidad
  carpinteria
  albanileria
  pintura
}

enum Distrito {
  trujillo
  el_porvenir
  florencia_de_mora
  huanchaco
  la_esperanza
  laredo
  moche
  poroto
  salaverry
  simbal
  victor_larco_herrera
}

model Usuario {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  nombre       String
  rol          Rol      @default(cliente)
  tecnico      Tecnico?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Tecnico {
  id                 Int                @id @default(autoincrement())
  usuarioId          Int                @unique
  usuario            Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  estadoVerificacion EstadoVerificacion @default(pendiente)
  oficio             Oficio?
  descripcion        String?
  aniosExperiencia   Int?
  distritos          Distrito[]
  disponibilidad     Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}