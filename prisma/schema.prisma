generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  cliente
  tecnico
  admin
}

enum EstadoVerificacion {
  pendiente
  en_revision
  aprobado
  observado
  rechazado
}

enum Oficio {
  gasfiteria
  electricidad
  carpinteria
  albanileria
  pintura
}

enum Distrito {
  trujillo
  el_porvenir
  florencia_de_mora
  huanchaco
  la_esperanza
  laredo
  moche
  poroto
  salaverry
  simbal
  victor_larco_herrera
}

model Usuario {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  nombre       String
  rol          Rol      @default(cliente)
  tecnico      Tecnico?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Tecnico {
  id                  Int                    @id @default(autoincrement())
  usuarioId           Int                    @unique
  usuario             Usuario                @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  estadoVerificacion  EstadoVerificacion     @default(pendiente)
  documentosEnviadosAt DateTime?
  oficio              Oficio?
  descripcion         String?
  aniosExperiencia    Int?
  distritos           Distrito[]
  disponibilidad      Json?
  documentos          DocumentoVerificacion[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
}

enum TipoDocumentoVerificacion {
  dni_frente
  dni_reverso
  selfie
  cul
  certificado_oficio
}

enum EstadoDocumento {
  pendiente
  aprobado
  observado
}

model DocumentoVerificacion {
  id              Int                       @id @default(autoincrement())
  tecnicoId       Int
  tecnico         Tecnico                   @relation(fields: [tecnicoId], references: [id], onDelete: Cascade)
  tipo            TipoDocumentoVerificacion
  publicId        String
  resourceType    String
  formato         String
  nombreOriginal  String
  bytes           Int
  estado          EstadoDocumento           @default(pendiente)
  comentarioAdmin String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([tecnicoId])
}