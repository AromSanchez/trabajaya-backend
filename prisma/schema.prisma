generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  cliente
  tecnico
  admin
}

enum EstadoVerificacion {
  pendiente
  en_revision
  verificado
  observado
  rechazado
  suspendido
}

enum Oficio {
  gasfiteria
  electricidad
  carpinteria
  albanileria
  pintura
}

enum Distrito {
  trujillo
  el_porvenir
  florencia_de_mora
  huanchaco
  la_esperanza
  laredo
  moche
  poroto
  salaverry
  simbal
  victor_larco_herrera
}

enum EstadoServicio {
  pendiente
  aceptado
  completado
  rechazado
  cancelado
  expirado
}

enum RolActor {
  cliente
  tecnico
  admin
  sistema
}

enum EstadoPropuesta {
  pendiente
  aceptada
  rechazada
}

enum TipoObjetivoReporte {
  tecnico
  cliente
  resena
}

enum CategoriaReporte {
  no_se_presento
  no_estaba
  trabajo_deficiente
  cobro_diferente
  comportamiento_inapropiado
  fraude
  contenido_inapropiado
  otro
}

enum EstadoReporte {
  pendiente
  resuelto
  descartado
}

enum TipoNotificacion {
  solicitud_nueva
  solicitud_aceptada
  solicitud_rechazada
  servicio_completado
  servicio_cancelado
  mensaje_nuevo
  resena_recibida
  propuesta_nueva
  propuesta_aceptada
  propuesta_rechazada
  verificacion_aprobada
  verificacion_observada
  verificacion_rechazada
  verificacion_suspendida
  reporte_resuelto
  reporte_descartado
}

model Configuracion {
  clave     String   @id
  valor     String
  updatedAt DateTime @updatedAt
}

model Usuario {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  nombre       String
  rol          Rol      @default(cliente)
  tecnico      Tecnico?
  historialVerificacion HistorialVerificacion[]
  serviciosCliente      Servicio[]             @relation("ServiciosCliente")
  serviciosCancelados   Servicio[]             @relation("ServiciosCancelados")
  serviciosCompletados  Servicio[]             @relation("ServiciosCompletados")
  historialServicio     HistorialServicio[]     @relation("HistorialServicioActor")
  mensajes              Mensaje[]
  propuestasCreadas     Propuesta[]             @relation("PropuestasCreadas")
  propuestasRespondidas Propuesta[]             @relation("PropuestasRespondidas")
  resenasCliente        Resena[]                @relation("ResenasCliente")
  resenasOcultadas      Resena[]                @relation("ResenasOcultadas")
  reportesCreados       Reporte[]               @relation("ReportesCreados")
  reportesRecibidos     Reporte[]               @relation("ReportesRecibidos")
  reportesResueltos     Reporte[]               @relation("ReportesResueltos")
  favoritos             Favorito[]              @relation("FavoritosCliente")
  notificaciones        Notificacion[]          @relation("Notificaciones")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Tecnico {
  id                  Int                    @id @default(autoincrement())
  usuarioId           Int                    @unique
  usuario             Usuario                @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  estadoVerificacion  EstadoVerificacion     @default(pendiente)
  documentosEnviadosAt DateTime?
  verificadoAt        DateTime?
  oficio              Oficio?
  descripcion         String?
  aniosExperiencia    Int?
  distritos           Distrito[]
  disponibilidad      Json?
  especialidades      String[]                @default([])
  disponible          Boolean                 @default(false)
  documentos          DocumentoVerificacion[]
  historial           HistorialVerificacion[]
  servicios           Servicio[]
  resenas             Resena[]
  calificacionPromedio Float?
  totalResenas        Int                     @default(0)
  serviciosCompletados Int                    @default(0)
  favoritos           Favorito[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
}

enum TipoDocumentoVerificacion {
  dni_frente
  dni_reverso
  selfie
  cul
  certificado_oficio
}

enum EstadoDocumento {
  pendiente
  aprobado
  observado
}

model DocumentoVerificacion {
  id              Int                       @id @default(autoincrement())
  tecnicoId       Int
  tecnico         Tecnico                   @relation(fields: [tecnicoId], references: [id], onDelete: Cascade)
  tipo            TipoDocumentoVerificacion
  publicId        String
  resourceType    String
  formato         String
  nombreOriginal  String
  bytes           Int
  estado          EstadoDocumento           @default(pendiente)
  comentarioAdmin String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([tecnicoId])
}

model HistorialVerificacion {
  id             Int                 @id @default(autoincrement())
  tecnicoId      Int
  tecnico        Tecnico             @relation(fields: [tecnicoId], references: [id], onDelete: Cascade)
  adminId        Int
  admin          Usuario             @relation(fields: [adminId], references: [id])
  estadoAnterior EstadoVerificacion
  estadoNuevo    EstadoVerificacion
  comentario     String?
  createdAt      DateTime            @default(now())

  @@index([tecnicoId])
}

model Servicio {
  id                 Int            @id @default(autoincrement())
  clienteId          Int
  cliente            Usuario        @relation("ServiciosCliente", fields: [clienteId], references: [id])
  tecnicoId          Int
  tecnico            Tecnico        @relation(fields: [tecnicoId], references: [id])
  descripcion        String
  fechaHora          DateTime
  distrito           Distrito
  direccion          String
  estado             EstadoServicio @default(pendiente)
  motivoRechazo      String?
  canceladoPorId     Int?
  canceladoPor       Usuario?       @relation("ServiciosCancelados", fields: [canceladoPorId], references: [id])
  canceladoPorRol    RolActor?
  motivoCancelacion  String?
  cancelacionTardia  Boolean        @default(false)
  completadoPorId    Int?
  completadoPor      Usuario?       @relation("ServiciosCompletados", fields: [completadoPorId], references: [id])
  completadoPorRol   RolActor?
  comisionPorcentaje Decimal        @default(0) @db.Decimal(5, 2)
  montoAcordado      Decimal?       @db.Decimal(10, 2)
  alcanceAcordado    String?
  aceptadoAt         DateTime?
  completadoAt       DateTime?
  canceladoAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  fotos              FotoServicio[]
  historial          HistorialServicio[]
  mensajes           Mensaje[]
  propuestas         Propuesta[]
  resena             Resena?
  reportes           Reporte[]

  @@index([clienteId])
  @@index([tecnicoId])
  @@index([estado])
}

model FotoServicio {
  id             Int      @id @default(autoincrement())
  servicioId     Int
  servicio       Servicio @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  publicId       String
  resourceType   String
  formato        String
  bytes          Int
  nombreOriginal String
  createdAt      DateTime @default(now())

  @@index([servicioId])
}

model HistorialServicio {
  id             Int             @id @default(autoincrement())
  servicioId     Int
  servicio       Servicio        @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  actorId        Int?
  actor          Usuario?        @relation("HistorialServicioActor", fields: [actorId], references: [id])
  actorRol       RolActor
  estadoAnterior EstadoServicio?
  estadoNuevo    EstadoServicio
  motivo         String?
  createdAt      DateTime        @default(now())

  @@index([servicioId])
}

model Mensaje {
  id         Int      @id @default(autoincrement())
  servicioId Int
  servicio   Servicio @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  autorId    Int
  autor      Usuario  @relation(fields: [autorId], references: [id])
  autorRol   RolActor
  contenido  String
  createdAt  DateTime @default(now())

  @@index([servicioId, createdAt])
}

model Propuesta {
  id              Int             @id @default(autoincrement())
  servicioId      Int
  servicio        Servicio        @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  monto           Decimal         @db.Decimal(10, 2)
  alcance         String
  estado          EstadoPropuesta @default(pendiente)
  creadaPorId     Int
  creadaPor       Usuario         @relation("PropuestasCreadas", fields: [creadaPorId], references: [id])
  respondidaPorId Int?
  respondidaPor   Usuario?        @relation("PropuestasRespondidas", fields: [respondidaPorId], references: [id])
  motivoRechazo   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([servicioId])
}

model Resena {
  id                 Int       @id @default(autoincrement())
  servicioId         Int       @unique
  servicio           Servicio  @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  clienteId          Int
  cliente            Usuario   @relation("ResenasCliente", fields: [clienteId], references: [id])
  tecnicoId          Int
  tecnico            Tecnico   @relation(fields: [tecnicoId], references: [id])
  calificacion       Int
  comentario         String?
  oculta             Boolean   @default(false)
  motivoOcultamiento String?
  ocultadaPorId      Int?
  ocultadaPor        Usuario?  @relation("ResenasOcultadas", fields: [ocultadaPorId], references: [id])
  ocultadaAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  reportes           Reporte[]

  @@index([tecnicoId, oculta])
}

model Reporte {
  id                Int                  @id @default(autoincrement())
  servicioId        Int
  servicio          Servicio             @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  reportanteId      Int
  reportante        Usuario              @relation("ReportesCreados", fields: [reportanteId], references: [id])
  reportanteRol     RolActor
  tipoObjetivo      TipoObjetivoReporte
  objetivoUsuarioId Int?
  objetivoUsuario   Usuario?             @relation("ReportesRecibidos", fields: [objetivoUsuarioId], references: [id])
  objetivoResenaId  Int?
  objetivoResena    Resena?              @relation(fields: [objetivoResenaId], references: [id])
  categoria         CategoriaReporte
  comentario        String?
  estado            EstadoReporte        @default(pendiente)
  resueltoPorId     Int?
  resueltoPor       Usuario?             @relation("ReportesResueltos", fields: [resueltoPorId], references: [id])
  notaResolucion    String?
  resueltoAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([servicioId])
  @@index([estado])
  @@index([reportanteId])
}

model Favorito {
  id        Int      @id @default(autoincrement())
  clienteId Int
  cliente   Usuario  @relation("FavoritosCliente", fields: [clienteId], references: [id], onDelete: Cascade)
  tecnicoId Int
  tecnico   Tecnico  @relation(fields: [tecnicoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([clienteId, tecnicoId])
  @@index([clienteId])
}

model Notificacion {
  id        Int              @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario          @relation("Notificaciones", fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      TipoNotificacion
  titulo    String
  mensaje   String?
  datos     Json?
  leida     Boolean          @default(false)
  leidaAt   DateTime?
  createdAt DateTime         @default(now())

  @@index([usuarioId, leida])
  @@index([usuarioId, createdAt])
}