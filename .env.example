# Copia este archivo a `.env` y completa los valores. No subas `.env` a git.
# URL de conexión a PostgreSQL (reemplaza usuario, contraseña, host, puerto y base de datos):
DATABASE_URL="postgresql://usuario:password@localhost:5432/mi_basedatos?schema=public"
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"