# Copia este archivo a `.env` y completa los valores. No subas `.env` a git.
# URL de conexión a PostgreSQL (reemplaza usuario, contraseña, host, puerto y base de datos):
DATABASE_URL="postgresql://usuario:password@localhost:5432/mi_basedatos?schema=public"
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Cloudinary (subida de documentos de verificación y fotos)
CLOUDINARY_CLOUD_NAME="tu-cloud-name"
CLOUDINARY_API_KEY="tu-api-key"
CLOUDINARY_API_SECRET="tu-api-secret"

# Datos del admin que crea `npm run seed:admin` (opcionales)
ADMIN_EMAIL="admin@trabajoya.com"
ADMIN_PASSWORD="cambia-esta-clave"
ADMIN_NOMBRE="Administrador"